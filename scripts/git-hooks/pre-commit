#!/usr/bin/env bash
# pre-commit hook — skill contract enforcement.
#
# For each plugins/*/skills/*/ that has staged changes to SKILL.md or
# helpers.py, run scripts/skill-contract-check.sh. Block the commit if
# any check reports a blocker.
#
# To bypass intentionally (e.g. work-in-progress commit on a branch):
#   git commit --no-verify
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHECK="$REPO_ROOT/scripts/skill-contract-check.sh"

if [[ ! -x "$CHECK" ]]; then
  # Hook is installed but the check script is missing — fail closed so
  # the user knows the tooling is in a half-installed state.
  echo "pre-commit: $CHECK not found or not executable. Either install" >&2
  echo "the hook properly (scripts/install-hooks.sh) or remove the hook." >&2
  exit 2
fi

# Connector-auth drift guard (gi-plugins#117): if any SKILL.md, the canonical
# shared/connector-auth.md, or the guard itself is staged, run the
# deterministic drift test. Fast (pure bash/awk, no API calls).
CONNECTOR_GUARD="$REPO_ROOT/scripts/test/connector-auth-guidance.test.sh"
if git diff --cached --name-only --diff-filter=ACMRD \
    | grep -qE '^(plugins/[^/]+/skills/[^/]+/SKILL\.md|plugins/lee-internal-comps/shared/connector-auth\.md|scripts/(test/connector-auth-guidance\.test\.sh|sync-connector-auth\.sh))$'; then
  if [[ ! -f "$CONNECTOR_GUARD" ]]; then
    echo "pre-commit: $CONNECTOR_GUARD missing — fail closed (reinstall hooks or restore the test)." >&2
    exit 2
  fi
  if ! bash "$CONNECTOR_GUARD"; then
    echo "" >&2
    echo "pre-commit: connector-auth guidance drifted. Edit the canonical" >&2
    echo "plugins/lee-internal-comps/shared/connector-auth.md, run" >&2
    echo "scripts/sync-connector-auth.sh, and re-stage. (--no-verify to bypass.)" >&2
    exit 1
  fi
fi

# Collect distinct skill dirs whose SKILL.md or helpers.py is staged.
# Avoid `mapfile` (bash 4+) so macOS system bash 3.2 also works.
SKILL_DIRS_RAW=$(
  git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '^plugins/[^/]+/skills/[^/]+/(SKILL\.md|helpers\.py)$' \
    | awk -F/ '{print $1"/"$2"/"$3"/"$4}' \
    | sort -u
)

if [[ -z "$SKILL_DIRS_RAW" ]]; then
  exit 0
fi

FAILED=0
while IFS= read -r s; do
  [[ -z "$s" ]] && continue
  bash "$CHECK" "$REPO_ROOT/$s" || FAILED=1
done <<< "$SKILL_DIRS_RAW"

if [[ "$FAILED" -ne 0 ]]; then
  echo "" >&2
  echo "pre-commit: one or more skills have drift. Resolve the issues above," >&2
  echo "or pass --no-verify to bypass (e.g. for WIP branch commits)." >&2
  exit 1
fi
exit 0
